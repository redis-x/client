{
	"name": "@redis-x/client",
	"version": "0.3.1-dev",
	"description": "Enhanced redis client built on top of \"redis\" package.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=15.0.0"
	},
	"peerDependencies": {
		"redis": "^4.6"
	},
	"devDependencies": {
		"@kirick/eslint-config": "^0.1.30",
		"@types/bun": "^1.2.18",
		"eslint": "9.8.0",
		"oxc-parser": "0.76.0",
		"publint": "0.3.12",
		"tsdown": "0.12.9",
		"type-fest": "^4.41.0",
		"typescript": "5.8.3",
		"unplugin-unused": "0.5.1",
		"valibot": "1.1.0",
		"vitest": "3.2.4"
	},
	"scripts": {
		"build:lib": "bun run build/main.ts",
		"build:ts": "tsdown src/main.ts --publint --unused --dts --format esm --format cjs",
		"check": "bun run build:lib && bun run lint && bun run build:ts && bun run test",
		"lint": "eslint . && tsc",
		"redis:down": "docker stop test-redis",
		"redis:up": "docker ps | grep test-redis >/dev/null || docker run --rm -d -p 16379:6379 --name test-redis redis:7-alpine",
		"test": "bun run redis:up && npm run test:vitest && bun test --coverage",
		"test:vitest": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/redis-x/client.git"
	},
	"keywords": [
		"redis",
		"client",
		"transaction",
		"multi"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/redis-x/client/issues"
	},
	"homepage": "https://github.com/redis-x/client#readme"
}
